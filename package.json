{
  "name": "qingchu-media-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "collect": "node scripts/monitor.mjs collect",
    "report": "node scripts/monitor.mjs report",
    "status": "node scripts/monitor.mjs status",
    "aisa": "aisa",
    "aisa:status": "node scripts/aisa-status.mjs",
    "aisa:import": "node scripts/aisa-import.mjs",
    "service:start": "node scripts/service.mjs start",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status",
    "refresh": "node scripts/run-refresh.mjs",
    "research:import": "node scripts/import-research.mjs"
  },
  "dependencies": {
    "@aisa-one/cli": "0.6.1",
    "fast-xml-parser": "5.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0"
  },
  "license": "MIT",
  "description": "Local Chinese AI media monitoring dashboard with public RSS, Codex research, evidence-linked briefs and topic drafts."
}
